# --- News → YouTube Publisher: frontend environment config ---
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Copy this file to ".env" (or ".env.local" to keep it out of git) in your
# project root, next to package.json.

# Base URL of your FastAPI/LangGraph backend
VITE_API_URL=http://localhost:8000

# Path (or full URL) to your logo image, served from /public or a CDN
VITE_LOGO_URL=src/assets/logo.png